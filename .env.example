# --- Database -------------------------------------------------------------
# Connection string for your Tiger Data service (Services page -> Connection
# info). Keep this file local; .env is git-ignored and never appears in
# screenshots or submissions.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/dbname?sslmode=require

# --- Embeddings -----------------------------------------------------------
# auto     -> uses OpenAI when a key is present, otherwise the keyless
#             feature-hashing fallback
# openai   -> force the OpenAI-compatible endpoint (recommended)
# hashing  -> force the keyless fallback
EMBEDDING_PROVIDER=auto

# OpenAI-compatible endpoint. Works with OpenAI directly; to use any other
# OpenAI-compatible service, set OPENAI_API_BASE to its /v1 base URL.
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# --- Tables ----------------------------------------------------------------
# Telemetry table streamed by VoltStream (time-series). ops_notes is created
# next to it in the same database.
TELEMETRY_TABLE=grid_readings
OPS_TABLE=ops_notes
